      "targets": [
        {
          "refId": "A",
          "alias": "Z2 Pace weekly (weighted)",
          "measurement": "ActivityGPS",
          "policy": "default",
          "resultFormat": "time_series",
          "orderByTime": "ASC",
          "query": "SELECT 1000.0 / mean(\"Speed\") AS \"Z2 Pace weekly (weighted)\" FROM \"ActivityGPS\" WHERE $timeFilter AND \"ActivitySelector\" =~ /running/ AND \"HeartRate\" >= $z2_hr AND \"HeartRate\" <= $z3_hr AND \"Speed\" >= 1.5 AND \"Speed\" <= 6 GROUP BY time(7d, 4d) fill(null) tz('Europe/Paris')",
          "rawQuery": true,
          "groupBy": [],
          "tags": []
        },
        {
          "refId": "B",
          "alias": "Z2 Volume (min)",
          "measurement": "ActivityGPS",
          "policy": "default",
          "resultFormat": "time_series",
          "orderByTime": "ASC",
          "query": "SELECT count(\"HeartRate\") / 60.0 AS \"Z2 Volume (min)\" FROM \"ActivityGPS\" WHERE $timeFilter AND \"ActivitySelector\" =~ /running/ AND \"HeartRate\" >= $z2_hr AND \"HeartRate\" <= $z3_hr GROUP BY time(7d, 4d) fill(0) tz('Europe/Paris')",
          "rawQuery": true,
          "groupBy": [],
