            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "WBGT": 0,
              "EF": 1
            },
            "renameByName": {}
          }
        }
      ],
