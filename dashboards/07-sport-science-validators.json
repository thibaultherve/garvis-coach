  "panels": [
    {
      "type": "timeseries",
      "id": 7,
      "title": "Aerobic Decoupling — EF 1st vs 2nd half per run",
      "description": "Median EF over the first 30 min vs 30-90 min. If 2nd half drops = endurance not yet solid. Target: gap < 5%.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "garmin_influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 4,
          "custom": {
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 5,
            "fillOpacity": 5
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "EF 1st half (0-30min)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "EF 2nd half (30-90min)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "calcs": [
            "mean",
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "alias": "EF 1st half (0-30min)",
          "measurement": "ActivityGPS",
          "policy": "default",
          "resultFormat": "time_series",
          "orderByTime": "ASC",
          "query": "SELECT median(\"RunningEfficiency\") AS \"EF 1st half (0-30min)\" FROM \"ActivityGPS\" WHERE $timeFilter AND \"ActivitySelector\" =~ /running/ AND \"DurationSeconds\" < 1800 AND \"RunningEfficiency\" > 0 GROUP BY time(1d) fill(null)",
          "rawQuery": true,
          "groupBy": [],
          "tags": []
        },
        {
          "refId": "B",
          "alias": "EF 2nd half (30-90min)",
          "measurement": "ActivityGPS",
          "policy": "default",
          "resultFormat": "time_series",
          "orderByTime": "ASC",
          "query": "SELECT median(\"RunningEfficiency\") AS \"EF 2nd half (30-90min)\" FROM \"ActivityGPS\" WHERE $timeFilter AND \"ActivitySelector\" =~ /running/ AND \"DurationSeconds\" >= 1800 AND \"DurationSeconds\" < 5400 AND \"RunningEfficiency\" > 0 GROUP BY time(1d) fill(null)",
          "rawQuery": true,
          "groupBy": [],
          "tags": []
        }
      ]
    },
    {
      "type": "barchart",
      "id": 8,
      "title": "Pace Z2 + Volume Z2 — weekly Mon→Sun (side-by-side bars)",
      "description": "Weekly bucket Mon-Sun (Europe/Paris TZ, current week included). Purple bar = mean Z2 pace weighted per-second (left axis, lower = faster). Grey bar = Z2 volume in minutes (right axis, pace reliability). Speed filter 1.5-6 m/s excludes walking/GPS spikes. Volume benchmarks: <30 min/wk = noisy (ignore pace), 30-60 = decent, >60 = robust.",
